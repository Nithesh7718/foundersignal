# Server Configuration
ENVIRONMENT=development
PROJECT_NAME="FounderSignal API"
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0

# Security & CORS (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL with psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://foundersignal:foundersignal_secret@localhost:5432/foundersignal
DB_ECHO=false

# Audio Storage Configuration
AUDIO_STORAGE_PATH=storage/audio
MAX_AUDIO_UPLOAD_SIZE_MB=25

# AI Provider Configurations (Gnani Prisma STT, Timbre TTS, LLM)
# Set MOCK_PROVIDERS=true to use local mock providers during development
MOCK_PROVIDERS=true
GNANI_PRISMA_API_KEY=your_gnani_prisma_api_key_here
GNANI_PRISMA_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_PRISMA_BATCH_ENDPOINT=https://api.vachana.ai/stt/v3/batch/jobs
TIMBRE_API_KEY=your_timbre_api_key_here
TIMBRE_ENDPOINT=https://api.gnani.ai/timbre/v1/tts

# LLM Extraction Provider (Google Gemini API / Mock)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# Background Worker Configuration
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=2.0
BATCH_STATUS_POLL_INTERVAL_SECONDS=10
WORKER_LEASE_DURATION_SECONDS=60
WORKER_BATCH_SIZE=5
MAX_JOB_RETRIES=3
MAX_BACKOFF_SECONDS=300
